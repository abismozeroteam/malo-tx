# Copy to .env.local for local development. Never commit real values.

# Neon Postgres (added through the Vercel Marketplace). Pooled connection string.
DATABASE_URL=

# pey API (https://docs.pey.mx)
PEY_API_KEY=
# Signing secret of the pey webhook (starts with whsec_)
PEY_WEBHOOK_SECRET=

# true charges exactly $0.01 MXN for every payment
DEMO_MODE=true

# Shared team secret that protects internal routes until sign-in exists
TEAM_SECRET=
